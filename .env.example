# ── Authentication ───────────────────────────────────────────────
# Choose ONE auth method. OAuth token is used with Claude Max subscriptions.
# API key is used with direct Anthropic API access.
# ANTHROPIC_API_KEY=sk-ant-...
# CLAUDE_CODE_OAUTH_TOKEN=sk-ant-oat01-...

# ── Model Selection ─────────────────────────────────────────────
# Which Claude model to use: opus, sonnet, or haiku
# NANOCLAW_MODEL=opus

# ── Assistant Identity ──────────────────────────────────────────
# The name your bot responds to. Used as the trigger pattern (@Name).
# ASSISTANT_NAME=Andy

# Set to "true" if the assistant has its own phone number (WhatsApp).
# ASSISTANT_HAS_OWN_NUMBER=

# ── Discord ─────────────────────────────────────────────────────
# Bot token from https://discord.com/developers/applications
# The bot needs these permissions: Send Messages, Read Messages, Manage Channels
DISCORD_BOT_TOKEN=

# Guild (server) ID where worker channels are created.
# Right-click your Discord server name → Copy Server ID (Developer Mode required).
DISCORD_GUILD_ID=

# ── Slack (read-only) ──────────────────────────────────────
# User token (xoxp-...) for reading Slack conversations.
# Workers use this to fetch messages when someone pastes a Slack URL.
# Create a Slack app with user token scopes: channels:history, groups:history,
# im:history, mpim:history, channels:read, groups:read, im:read, mpim:read, users:read
# SLACK_USER_TOKEN=xoxp-...

# ── GitHub ──────────────────────────────────────────────────────
# Path to a file containing a GitHub PAT (classic, with `repo` scope).
# Workers use this to clone private repos via HTTPS.
# Note: This is set as a systemd Environment var, not in .env:
#   Environment=NANOCLAW_GITHUB_TOKEN_PATH=/path/to/github_token
# See docs/guides/setup.md for details.

# ── Docker (optional) ──────────────────────────────────────────
# Set to "true" to give the main agent access to the Docker socket.
# Only the main group gets this — worker containers never get Docker access.
# NANOCLAW_ENABLE_DOCKER=false

# E2E testing: debug bot ID(s) treated as human users (comma-separated)
# DISCORD_ALLOWED_BOT_IDS=

# Debug bot token (stored at ~/.config/nanoclaw/debug_bot_token)
# Used by ncf test for true end-to-end Discord testing
# DISCORD_DEBUG_BOT_TOKEN_PATH=~/.config/nanoclaw/debug_bot_token

# ── OpenAI-Compatible Inference Shim (optional) ─────────────────
# Required to run workers through an OpenAI-compatible inference backend
# (e.g., Neuralwatt at portal.neuralwatt.com, or any other provider that
# speaks the OpenAI chat-completions API).
# Read by tools/anthropic-shim.ts (listens on port 3003).
# Env var names are NEURALWATT_* for historical reasons — any OpenAI-
# compatible provider works by overriding NEURALWATT_BASE_URL.
# See docs/guides/setup.md § 9 for installation.
# NEURALWATT_API_KEY=sk-...
# NEURALWATT_BASE_URL=https://api.neuralwatt.com/v1
